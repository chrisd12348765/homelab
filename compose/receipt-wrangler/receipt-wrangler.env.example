# Copy to .env for a manual deployment. The Ansible playbook instead decrypts
# receipt-wrangler.enc.env on the controller and writes /opt/receipt-wrangler/.env.
ENCRYPTION_KEY=replace-with-16-to-32-random-characters
SECRET_KEY=replace-with-16-to-32-random-characters
DB_USER=wrangler
DB_PASSWORD=replace-with-a-random-password
DB_NAME=wrangler
TZ=America/New_York
